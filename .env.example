# Demo mode requires no external credentials. Leave these unset to use it.
# Never commit real Supabase, Meta, n8n, or other service credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only; do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SNAPGAD_N8N_SHARED_SECRET=replace-with-a-long-random-secret
SNAPGAD_ACTIVE_ORGANIZATION_COOKIE_SECRET=replace-with-a-different-long-random-secret
SNAPGAD_N8N_COPY_URL=https://n8n.example.com/webhook/snapgad/content/copy
SNAPGAD_N8N_PUBLISH_URL=https://n8n.example.com/webhook/snapgad/content/publish
# Server-only token for the internal aggregate worker health endpoint.
SNAPGAD_WORKER_HEALTH_TOKEN=replace-with-a-long-random-health-token
# The worker does not run without an explicit, server-owned processor module.
SNAPGAD_COPY_WORKER_MODULE=./worker/providers/copy-processor.ts
SNAPGAD_COPY_WORKER_PROVIDER=local
SNAPGAD_WORKER_POLL_INTERVAL_MS=5000
SNAPGAD_WORKER_LEASE_DURATION_MS=600000
SNAPGAD_WORKER_HEARTBEAT_INTERVAL_MS=300000
SNAPGAD_WORKER_RECOVERY_INTERVAL_MS=60000
# Keep false/unset. Publication delivery is blocked until tenant Meta staging
# and the reviewed target-scoped worker are explicitly enabled.
SNAPGAD_PUBLISH_WORKER_ENABLED=false

# Server-only Meta configuration. The portal currently exposes a preflight
# only; setting these variables does not enable or trigger publication.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Copy processor (worker/providers/copy-processor.ts) — server-only, never in the browser.
OPENROUTER_API_KEY=
SNAPGAD_COPY_OPENROUTER_MODEL=
SNAPGAD_COPY_TIMEOUT_MS=45000
SNAPGAD_COPY_MAX_OUTPUT_TOKENS=700
SNAPGAD_COPY_MAX_REQUEST_COST_USD=0.05
SNAPGAD_COPY_MODEL_INPUT_PRICE_PER_1M_USD=
SNAPGAD_COPY_MODEL_OUTPUT_PRICE_PER_1M_USD=
